{
  "manifest_version": 3,
  "name": "Workflow Stream - Real-Time Tasks & Focus",
  "version": "1.0.0",
  "description": "Real-time task synchronization, AI focus rezoning, and browser context tracking for macOS & Android workflow.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8765/*",
    "ws://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Workflow Stream",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}