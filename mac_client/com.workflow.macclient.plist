<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.workflow.macclient</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>mac_client.mac_daemon</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SERVER_URL</key>
        <string>http://localhost:8765</string>
        <key>OBSIDIAN_VAULT_DIR</key>
        <string>/Users/rahman/Documents/Obsidian Vault/Task-List</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/rahman/Library/Logs/workflow_macclient_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/rahman/Library/Logs/workflow_macclient_stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
